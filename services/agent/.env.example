AGENT_ENVIRONMENT=development
AGENT_LOG_LEVEL=INFO
AGENT_DATABASE_URL=postgresql://agent:agent_local@127.0.0.1:55432/zaowu_agent?sslmode=disable
AGENT_DATABASE_POOL_MIN_SIZE=1
AGENT_DATABASE_POOL_MAX_SIZE=5
AGENT_DATABASE_CONNECT_TIMEOUT_SECONDS=10
AGENT_CHECKPOINT_AUTO_SETUP=true

# Product API -> Agent service authentication.
AGENT_SERVICE_TOKEN=

# Agent service -> TypeScript Tool Gateway. `npm run dev` uses port 5173 by
# default. The branded `scripts/open-local-domain.ps1` launcher uses the direct
# application port 8787 instead (the browser-only proxy is on port 80).
AGENT_GATEWAY_URL=http://127.0.0.1:5173/api/agent-tools
AGENT_GATEWAY_TOKEN=
AGENT_GATEWAY_TIMEOUT_SECONDS=20

# OpenAI-compatible planner/replanner model used through LangChain.
AGENT_MODEL_API_KEY=
AGENT_MODEL_BASE_URL=https://api.openai.com/v1
AGENT_MODEL_NAME=
AGENT_MODEL_TIMEOUT_SECONDS=60
AGENT_MODEL_MAX_OUTPUT_TOKENS=4000
# Configure these from the selected provider's current price sheet. Keep zero
# only when monetary estimates are intentionally disabled; token caps remain active.
AGENT_MODEL_INPUT_COST_PER_MILLION_USD=0
AGENT_MODEL_OUTPUT_COST_PER_MILLION_USD=0

# Optional development observability. LangSmith receives redacted trace data;
# PostgreSQL checkpoints remain the only execution/recovery source of truth.
# Never commit the API key or put it in the product/browser environment.
AGENT_LANGSMITH_TRACING=false
AGENT_LANGSMITH_API_KEY=
AGENT_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
AGENT_LANGSMITH_PROJECT=zaowu-agent-development
# Required only when the API key can access more than one LangSmith workspace.
AGENT_LANGSMITH_WORKSPACE_ID=
AGENT_LANGSMITH_FLUSH_TIMEOUT_SECONDS=5

# Independent orchestration budgets enforced outside model output.
AGENT_MAX_PLAN_ATTEMPTS=3
AGENT_MAX_REPLANS=2
AGENT_MAX_TOOL_CALLS=18
AGENT_MAX_PLAN_STEPS=4
AGENT_MAX_MODEL_TOKENS=40000
AGENT_MAX_ESTIMATED_COST_USD=2
AGENT_MAX_RUN_AGE_SECONDS=86400

# Defense in depth for checkpoint deserialization. The service also configures
# an explicit strict serializer so safety does not depend on this variable.
LANGGRAPH_STRICT_MSGPACK=true
