# Server-side secrets only. Never add real values to source control.
AI_API_KEY=
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# Optional model override for requests that include an image.
AI_VISION_MODEL=
TRIPO_API_KEY=
# Optional webhook signing secret from Tripo Console → Settings → Webhooks.
TRIPO_WEBHOOK_SECRET=
# Tripo v3 region is fixed into each newly submitted task: global or china.
TRIPO_REGION=global
TRIPO_PROXY_URL=
TRIPO_PROXY_BRIDGE_URL=
# Optional exact additional vendor-confirmed CDN hostnames, comma separated.
# cdn.tripo3d.ai is always allowed; never put a complete URL or wildcard here.
TRIPO_DOWNLOAD_HOSTS=
# Explicitly enables the loopback-only Golden Scenario demo identity.
LOCAL_DEMO_MODE=false

# Product-to-Agent API. Use a long random shared secret; keep it identical to
# AGENT_SERVICE_TOKEN in services/agent/.env.
AGENT_SERVICE_URL=http://127.0.0.1:8001
AGENT_SERVICE_TOKEN=

# Agent-to-product Tool Gateway. Keep it identical to AGENT_GATEWAY_TOKEN in
# services/agent/.env. This credential does not authenticate browser users.
AGENT_TOOL_GATEWAY_TOKEN=
