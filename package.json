{
  "name": "zaowu-engineering-workbench",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "package:executor": "node scripts/build-executor-package.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-core-tests.mjs",
    "agent:sync": "uv sync --project services/agent --frozen",
    "demo:services": "node scripts/start-demo-services.mjs",
    "demo:check": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/check-local-launcher.ps1",
    "agent:dev": "uv run --project services/agent python -m zaowu_agent.main --port 8001 --reload",
    "agent:studio": "uv run --directory services/agent langgraph dev --config langgraph.json --no-browser",
    "agent:lint": "uv run --project services/agent ruff check services/agent/src services/agent/tests",
    "agent:format:check": "uv run --project services/agent ruff format --check services/agent/src services/agent/tests",
    "agent:typecheck": "uv run --project services/agent mypy --config-file services/agent/pyproject.toml services/agent/src services/agent/tests",
    "agent:test": "uv run --project services/agent pytest -m \"not integration\" services/agent/tests",
    "agent:test:integration": "node scripts/run-agent-postgres-tests.mjs",
    "agent:check": "npm run agent:lint && npm run agent:format:check && npm run agent:typecheck && npm run agent:test",
    "check": "npm run typecheck && npm run lint && npm test && npm run agent:check && npm run build",
    "validate:quality-baseline": "node validation/quality-baseline.cjs",
    "validate:tripo-preview": "node validation/tripo-preview.cjs",
    "validate:candidate-comparison": "node validation/candidate-quality-comparison.cjs",
    "validate:tripo-intake": "node validation/tripo-intake.cjs",
    "validate:tripo-intake-service": "node validation/tripo-intake-service.cjs",
    "validate:tripo-intake-local": "node validation/tripo-intake-local.cjs",
    "validate:golden-cad-design": "node validation/golden-cad-design.cjs",
    "prepare:p1e-cad": "node validation/p1e-prepare-cad.cjs",
    "validate:p1e-visual-export": "node validation/p1e-visual-export.cjs",
    "validate:p1g": "node validation/p1g-boundaries.cjs",
    "validate:p1g-real-package": "node validation/p1g-real-package.cjs",
    "validate:p1h-closure": "node validation/p1h-closure.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "db:check:local": "node scripts/migrate-local.mjs --check",
    "preflight:tripo": "node scripts/tripo-preflight.mjs",
    "tripo:proxy": "node scripts/tripo-proxy-bridge.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "undici": "7.24.8",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
